APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = onetime_link
USERNAME = root
PASSWORD = your_password
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = onetime_
DEBUG = true

[LANG]
default_lang = zh-cn

# 日志配置
[LOG]
CHANNEL = file
LEVEL = debug,info,notice,error,sql
